# SQLAlchemy connection string to the local MySQL/MariaDB server
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/indraquant

# Redis connection string
REDIS_URL=redis://127.0.0.1:6379/0

# JWT signing secret (generate a long random string) and token lifetime
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=1440

# Single-user bootstrap credentials (created at startup if missing, ADR-013)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
