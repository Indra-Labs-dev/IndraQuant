# SQLAlchemy connection string to the shared Homelab PostgreSQL (~/Homelab).
# Credentials come from ~/Homelab/.env (POSTGRES_USER/POSTGRES_PASSWORD). The
# "indraquant" database is created via ~/Homelab/scripts/create-database.sh indraquant.
# Host is "postgres" when running via the project's docker-compose.yml (joins
# indralabs-network); use "localhost" instead if running the backend natively.
DATABASE_URL=postgresql+psycopg://indra_admin:password@postgres:5432/indraquant

# Redis connection string (shared Homelab instance, ~/Homelab/.env for REDIS_PASSWORD).
# DB index 2 is reserved for IndraQuant (index 1 is used by the A.R.S.E.N.I.C project -
# see ~/Homelab/README.md before picking a different index for a new project).
# Host is "redis" via docker-compose.yml, or "localhost" when running natively.
REDIS_URL=redis://:password@redis:6379/2

# JWT signing secret (generate a long random string) and token lifetime
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=1440

# Single-user bootstrap credentials (created at startup if missing, ADR-013)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
